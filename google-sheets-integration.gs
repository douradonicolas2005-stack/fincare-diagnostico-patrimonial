// Monta o "ebook" do diagnostico (capa com logo/slogan, miolo com dashboard
// executivo + resumo + perfil + diversificacao + recomendacoes, e contracapa
// com o cartao de visitas), separado em paginas via page-break-after, e
// converte tudo para PDF. Mesmas secoes e mesmos numeros do relatorio final
// mostrado na tela do simulador (renderRelatorioFinal() e
// renderExecutiveDashboard() no HTML) - qualquer numero novo mostrado la
// precisa estar tambem no payload de finalizeReport() para chegar aqui.
function gerarPdfDiagnostico_(data) {
  var nome = (data.nome || "").trim()
  var score = Math.round(Number(data.score_patrimonial) || 0)
  var perfilNome = data.perfil_investidor || ""
  var perfilDescricao = data.perfil_investidor_descricao || ""

  var anos = data.anos_ate_independencia
  var temAnos = anos !== null && anos !== undefined && anos !== ""
  var idadeFinal =
    temAnos && data.idade_atual ? Number(data.idade_atual) + Number(anos) : null

  // ---- Dashboard Executivo: mesmos 6 KPIs do topo da tela final ----
  var patrimonioAtualTotal =
    (Number(data.patrimonio_atual) || 0) +
    (Number(data.diagnostico_avancado_patrimonio_liquido_adicional) || 0)

  var execCards = [
    ["Patrimonio atual", formatarMoeda_(patrimonioAtualTotal)],
    [
      "Patrimonio projetado (10 anos)",
      formatarMoeda_(data.patrimonio_projetado_10anos)
    ],
    ["Meta patrimonial", formatarMoeda_(data.patrimonio_necessario)],
    ["Renda passiva desejada", formatarMoeda_(data.renda_desejada) + "/mes"],
    [
      "Idade da independencia",
      idadeFinal ? idadeFinal + " anos" : "A ajustar com especialista"
    ],
    ["Score patrimonial", score + "%"]
  ]

  var execCardsHtml = ""
  for (var i = 0; i < execCards.length; i += 2) {
    execCardsHtml +=
      "<tr>" +
      '<td style="width:50%;padding:6px;">' +
      montarCardExecutivo_(execCards[i][0], execCards[i][1]) +
      "</td>" +
      '<td style="width:50%;padding:6px;">' +
      montarCardExecutivo_(execCards[i + 1][0], execCards[i + 1][1]) +
      "</td>" +
      "</tr>"
  }
  execCardsHtml =
    '<table style="width:100%;border-collapse:collapse;margin-bottom:8px;">' +
    execCardsHtml +
    "</table>"

