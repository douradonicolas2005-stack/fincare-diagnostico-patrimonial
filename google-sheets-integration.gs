// Sem casas decimais, igual ao formatarMoeda() do simulador (toLocaleString
// com maximumFractionDigits:0) - o PDF antigo mostrava centavos, um valor
// diferente do que a pessoa viu na tela.
function formatarMoeda_(valor) {
  valor = Math.round(Number(valor) || 0)
  var sinal = valor < 0 ? "-" : ""
  var inteiro = String(Math.abs(valor)).replace(/\B(?=(\d{3})+(?!\d))/g, ".")
  return sinal + "R$ " + inteiro
}

